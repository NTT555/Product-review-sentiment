# --- Cell 1: Import các thư viện và module cần thiết ---
import sys
sys.path.append('..')  # để import module src

import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.linear_model import LogisticRegression
from sklearn.metrics import confusion_matrix
from src.evaluate import evaluate_model, optimize_alpha_gridsearch
from src.features import X_train, X_test, y_train, y_test  # giả sử đã có từ thành viên 3

# --- Cell 2: Tối ưu tham số alpha cho MultinomialNB ---
print(" Bắt đầu tối ưu tham số alpha cho mô hình MultinomialNB bằng Grid Search...")

best_nb_model, best_params, grid_search_result = optimize_alpha_gridsearch(X_train, y_train, cv=5)

print(f"\n✅ Tham số alpha tốt nhất được chọn: {best_params['alpha']}")

# --- Cell 3: Huấn luyện Logistic Regression baseline ---
print("\n Huấn luyện Logistic Regression baseline để so sánh...")

lr_model = LogisticRegression(max_iter=300, random_state=42)
lr_model.fit(X_train, y_train)

# --- Cell 4: Dự đoán và đánh giá trên tập test ---
print("\n Đánh giá mô hình Multinomial Naive Bayes sau tối ưu trên tập test:")
nb_preds = best_nb_model.predict(X_test)
nb_metrics = evaluate_model(y_test, nb_preds, labels=['negative', 'positive'])

print("\n Đánh giá mô hình Logistic Regression trên tập test:")
lr_preds = lr_model.predict(X_test)
lr_metrics = evaluate_model(y_test, lr_preds, labels=['negative', 'positive'])

# --- Cell 5: So sánh trực quan bằng Ma trận nhầm lẫn (Confusion Matrix) ---
fig, axes = plt.subplots(1, 2, figsize=(14, 5))

# Confusion Matrix của Naive Bayes
sns.heatmap(confusion_matrix(y_test, nb_preds), annot=True, fmt='d', cmap='Blues', ax=axes[0],
            xticklabels=['negative', 'positive'], yticklabels=['negative', 'positive'])
axes[0].set_title('Naive Bayes - Confusion Matrix', fontsize=12, fontweight='bold')
axes[0].set_xlabel('Máy dự đoán (Predicted)')
axes[0].set_ylabel('Thực tế (Actual)')

# Confusion Matrix của Logistic Regression
sns.heatmap(confusion_matrix(y_test, lr_preds), annot=True, fmt='d', cmap='Greens', ax=axes[1],
            xticklabels=['negative', 'positive'], yticklabels=['negative', 'positive'])
axes[1].set_title('Logistic Regression - Confusion Matrix', fontsize=12, fontweight='bold')
axes[1].set_xlabel('Máy dự đoán (Predicted)')
axes[1].set_ylabel('Thực tế (Actual)')

plt.tight_layout()
plt.show()

# --- Cell 6: So sánh chỉ số F1-score và kết luận ---
print(" So sánh chỉ số F1-Score giữa hai mô hình:")
print(f"Naive Bayes (alpha={best_params['alpha']}): F1 = {nb_metrics['f1_score']:.4f}")
print(f"Logistic Regression: F1 = {lr_metrics['f1_score']:.4f}")

diff = nb_metrics['f1_score'] - lr_metrics['f1_score']
if diff > 0:
    print(f" Mô hình Naive Bayes tốt hơn với F1-score cao hơn {diff:.4f}")
elif diff < 0:
    print(f" Mô hình Logistic Regression tốt hơn với F1-score cao hơn {-diff:.4f}")
else:
    print(" Hai mô hình có F1-score tương đương.")
