# --- Import thư viện cần thiết ---
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.metrics import confusion_matrix, classification_report, f1_score
from sklearn.naive_bayes import MultinomialNB
from sklearn.linear_model import LogisticRegression

from src.evaluate import optimize_alpha_gridsearch, evaluate_model

# --- 1. Huấn luyện mô hình Naive Bayes baseline (alpha = 1.0) ---
nb_baseline = MultinomialNB(alpha=1.0)
nb_baseline.fit(X_train, y_train)
nb_preds_baseline = nb_baseline.predict(X_test)

print("=== BÁO CÁO: Naive Bayes baseline (alpha=1.0) ===")
print(f"Accuracy: {f1_score(y_test, nb_preds_baseline, average='weighted'):.4f}")
print(classification_report(y_test, nb_preds_baseline, zero_division=0))

# --- 2. Tối ưu tham số alpha với GridSearchCV ---
print(" Tối ưu tham số alpha bằng GridSearchCV:")
best_nb_model, best_params, grid_search_result = optimize_alpha_gridsearch(X_train, y_train, cv=5)
print(f"Tham số alpha tốt nhất: {best_params['alpha']}")

# Huấn luyện lại NB với alpha tối ưu đã có ở trên (best_nb_model có sẵn)
nb_preds_opt = best_nb_model.predict(X_test)
print("=== BÁO CÁO: Naive Bayes tối ưu ===")
evaluate_model(y_test, nb_preds_opt, labels=['negative', 'positive'])

# --- 3. Huấn luyện Logistic Regression cho đối chiếu ---
lr_model = LogisticRegression(max_iter=1000, class_weight='balanced', random_state=42)
lr_model.fit(X_train, y_train)
lr_preds = lr_model.predict(X_test)

print("=== BÁO CÁO: Logistic Regression ===")
evaluate_model(y_test, lr_preds, labels=['negative', 'positive'])

# --- 4. So sánh F1-score giữa các mô hình ---
f1_baseline = f1_score(y_test, nb_preds_baseline, average='weighted')
f1_opt = f1_score(y_test, nb_preds_opt, average='weighted')
f1_lr = f1_score(y_test, lr_preds, average='weighted')

print(f"\nF1-score Naive Bayes baseline (alpha=1.0): {f1_baseline:.4f}")
print(f"F1-score Naive Bayes tối ưu (alpha={best_params['alpha']}): {f1_opt:.4f}")
print(f"F1-score Logistic Regression: {f1_lr:.4f}")

# --- 5. Vẽ ma trận nhầm lẫn so sánh trực quan ---
fig, axes = plt.subplots(1, 3, figsize=(21, 5))

# NB baseline
sns.heatmap(confusion_matrix(y_test, nb_preds_baseline), annot=True, fmt='d', cmap='Blues', ax=axes[0],
            xticklabels=['negative', 'positive'], yticklabels=['negative', 'positive'])
axes[0].set_title('NB baseline (alpha=1.0)', fontsize=12, fontweight='bold')
axes[0].set_xlabel('Máy dự đoán (Predicted)')
axes[0].set_ylabel('Thực tế (Actual)')

# NB tối ưu
sns.heatmap(confusion_matrix(y_test, nb_preds_opt), annot=True, fmt='d', cmap='Purples', ax=axes[1],
            xticklabels=['negative', 'positive'], yticklabels=['negative', 'positive'])
axes[1].set_title(f'NB tối ưu (alpha={best_params["alpha"]})', fontsize=12, fontweight='bold')
axes[1].set_xlabel('Máy dự đoán (Predicted)')
axes[1].set_ylabel('Thực tế (Actual)')

# Logistic Regression
sns.heatmap(confusion_matrix(y_test, lr_preds), annot=True, fmt='d', cmap='Greens', ax=axes[2],
            xticklabels=['negative', 'positive'], yticklabels=['negative', 'positive'])
axes[2].set_title('Logistic Regression', fontsize=12, fontweight='bold')
axes[2].set_xlabel('Máy dự đoán (Predicted)')
axes[2].set_ylabel('Thực tế (Actual)')

plt.tight_layout()
plt.show()
